# ==========================================
# MERCADOPAGO CHECKOUT BRICKS CONFIGURATION
# ==========================================

# IMPORTANTE: Para Checkout Bricks puedes usar credenciales TEST normales:
# 1. Ve a https://www.mercadopago.cl/developers/panel/app
# 2. Crea una aplicación
# 3. Usa las credenciales TEST (sandbox) - ¡Mucho más fácil!
# 4. Usa las tarjetas de prueba que aparecen en la documentación

# ACCESS TOKEN (privado - para el servidor)  
# ✅ USAR CREDENCIALES TEST (SANDBOX) 
# Formato: TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_ACCESS_TOKEN=TEST-tu-test-access-token-aqui

# PUBLIC KEY (público - para el frontend)
# ✅ USAR CREDENCIALES TEST (SANDBOX)
# Formato: TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-tu-test-public-key-aqui

# ==========================================
# SITE CONFIGURATION - DINÁMICO PARA LOCAL Y VERCEL
# ==========================================

# 🚀 CONFIGURACIÓN AUTOMÁTICA:
# ✅ LOCAL: Se detecta automáticamente (http://localhost:3000)
# ✅ VERCEL: Se detecta automáticamente (https://tu-app.vercel.app)
#
# SOLO configura NEXT_PUBLIC_SITE_URL si necesitas una URL personalizada
# Si NO se define, el sistema usa automáticamente:
# - Local: http://localhost:3000 (o el puerto que uses)
# - Vercel: https://VERCEL_URL (URL automática de Vercel)

# URL personalizada (OPCIONAL - solo si necesitas overridejar la detección automática)
# NEXT_PUBLIC_SITE_URL=https://tu-dominio-personalizado.com

# ⚙️ Para desarrollo local con puerto específico (OPCIONAL):
# Si Next.js usa un puerto diferente al 3001, puedes especificarlo:
# NEXT_PUBLIC_PORT=3000
# O configurar la URL completa:
# NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ⚙️ Otras URLs específicas (NORMALMENTE NO NECESARIAS):
# NEXT_PUBLIC_SUCCESS_URL=
# NEXT_PUBLIC_FAILURE_URL=  
# NEXT_PUBLIC_PENDING_URL=

# ==========================================
# EJEMPLO DE CREDENCIALES TEST
# ==========================================
# Estas son credenciales de ejemplo - obtén las tuyas reales del panel de MercadoPago
# MERCADOPAGO_ACCESS_TOKEN=TEST-1234567890123456-010203-abcdefghijklmnopqrstuvwxyz123456-98765432
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-a1b2c3d4-e5f6-7890-1234-567890abcdef

# ==========================================
# EMAIL CONFIGURATION (para envío de tickets)
# ==========================================

# Configuración para Gmail (recomendado para pruebas)
# 1. Ve a tu cuenta de Gmail
# 2. Activa la verificación en 2 pasos
# 3. Genera una "Contraseña de aplicación" específica
# 4. Usa esa contraseña aquí (NO tu contraseña normal)

EMAIL_USER=tu-email@gmail.com
EMAIL_PASSWORD=tu-contraseña-de-aplicacion

# ==========================================
# KHIPU CONFIGURATION (API v2.0)
# ==========================================
KHIPU_RECEIVER_ID=tu-receiver-id-aqui
KHIPU_SECRET=tu-llave-secreta-aqui

# ==========================================
# NOTAS IMPORTANTES PARA CHECKOUT BRICKS
# ==========================================
# 1. Nunca subas el archivo .env.local a Git
# 2. Las credenciales TEST son para pruebas y funcionan perfectamente
# 3. Las credenciales de PRODUCCIÓN son para pagos reales
# 4. El ACCESS_TOKEN va en el servidor (privado)
# 5. El PUBLIC_KEY va en el frontend (público)
# 6. Con Bricks puedes probar todo el flujo sin problemas de autenticación
# 7. Para emails: usa Gmail con contraseña de aplicación para pruebas